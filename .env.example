# M-Pesa API Credentials (from Safaricom Developer Portal)
CONSUMER_KEY=your_consumer_key_here
CONSUMER_SECRET=your_consumer_secret_here

# M-Pesa Configuration
SHORTCODE=174379
PASSKEY=your_passkey_here

# Safaricom API Endpoint
BASE_URL=https://sandbox.safaricom.co.ke

# Callback URL (must be publicly accessible HTTPS endpoint)
CALLBACK_URL=https://your-domain.com/api/mpesa/callback

# Firebase Configuration (Required for production)
# Get this from Firebase Console → Project Settings → Service Accounts → Generate new private key
# Paste the entire JSON content as a single-line string (replace newlines with \n)
FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"your-project-id",...}

# Server Configuration
PORT=3000
NODE_ENV=development
