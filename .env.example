# M-Pesa API Credentials (Safaricom production Go-Live values - DO NOT COMMIT REAL VALUES)
# Copy this file to `.env` (gitignored) and paste your real keys there instead.
CONSUMER_KEY=your_production_consumer_key_here
CONSUMER_SECRET=your_production_consumer_secret_here

# Lipa na M-Pesa / Buy Goods Till - SHORTCODE = your Till number, PASSKEY must belong to it
SHORTCODE=your_buy_goods_till_number_here
PASSKEY=your_till_passkey_here

# Production endpoint; sandbox = https://sandbox.safaricom.co.ke
BASE_URL=https://api.safaricom.co.ke

# Callback URL (must be publicly accessible HTTPS endpoint)
CALLBACK_URL=https://your-app-name.onrender.com/api/mpesa/callback

# Firebase Configuration (Required for production)
# Get this from Firebase Console → Project Settings → Service Accounts
FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"your-project-id","private_key_id":"your-private-key-id","private_key":"-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY_HERE\n-----END PRIVATE KEY-----\n","client_email":"your-service-account@your-project.iam.gserviceaccount.com","client_id":"your-client-id","auth_uri":"https://accounts.google.com/o/oauth2/auth","token_uri":"https://oauth2.googleapis.com/token","auth_provider_x509_cert_url":"https://www.googleapis.com/oauth2/v1/certs","client_x509_cert_url":"https://www.googleapis.com/robot/v1/metadata/x509/your-service-account%40your-project.iam.gserviceaccount.com","universe_domain":"googleapis.com"}

# Account Balance API - Initiator-based credentials, SEPARATE from
# CONSUMER_KEY/SECRET above. Set up on the Daraja portal under the
# Account Balance / B2C API product.
# SecurityCredential is built at request time by RSA-encrypting
# INITIATOR_PASSWORD against Safaricom's public certificate (see
# security_credential.js). The certificate itself is not a secret -
# it's committed at certs/ProductionCertificate.cer. Override its
# location with MPESA_CERT_PATH if you ever need a different file.
INITIATOR_NAME=your_initiator_name_here
INITIATOR_PASSWORD=your_initiator_password_here
MPESA_CERT_PATH=

# Defaults to SHORTCODE above if not set - only override if Safaricom
# tells you Account Balance must be queried against a different
# shortcode/till.
ACCOUNT_BALANCE_SHORTCODE=

# Must be publicly accessible HTTPS endpoints (same domain as CALLBACK_URL)
ACCOUNT_BALANCE_RESULT_URL=https://your-app-name.onrender.com/api/mpesa/account-balance/result
ACCOUNT_BALANCE_TIMEOUT_URL=https://your-app-name.onrender.com/api/mpesa/account-balance/timeout

# Pull Transactions API - reconciliation for C2B transactions Safaricom
# processed on our ShortCode but whose callback never reached
# /api/c2b/confirmation (e.g. during downtime). Registered once via
# POST /api/mpesa/pull/register, then queried via
# GET /api/mpesa/pull/query?startDate=...&endDate=...&offset=0
# NominatedNumber = the MSISDN tied to the Shortcode's KYC details on the
# M-PESA org portal (Business Admin/Manager account), not an arbitrary number.
PULL_NOMINATED_NUMBER=254700000000
PULL_CALLBACK_URL=https://your-app-name.onrender.com/api/mpesa/pull/callback

# Server Configuration
PORT=3000
NODE_ENV=production